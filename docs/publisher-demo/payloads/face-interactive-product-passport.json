{
  "name": "Viewer Demo - Interactive Product Passport Face",
  "renderer": "go-template",
  "renderer_config": {
    "demo": "interactive-product-passport",
    "version": 1,
    "attribute_categories": ["identity", "sustainability", "lifecycle"]
  },
  "views": [
    {
      "variant": "default",
      "media_type": "text/html",
      "aspect_ratio": "16/10",
      "interactive": true,
      "content": "<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><style>*{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:Arial,sans-serif;background:#071d24;color:#f4fbfc}body{padding:22px}.passport{min-height:456px;border:1px solid #2aaec3;border-radius:28px;padding:28px;background:radial-gradient(circle at 92% 4%,#1f8797 0,transparent 34%),linear-gradient(145deg,#0b2730,#071a20);box-shadow:0 22px 50px #0006}.eyebrow{margin:0;color:#73d9e7;font-size:12px;font-weight:800;letter-spacing:.18em;text-transform:uppercase}.head{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;margin:12px 0 22px}.head h1{margin:0;font-size:clamp(26px,6vw,48px);line-height:1.05}.head p{max-width:520px;margin:9px 0 0;color:#b9d8dd;font-size:15px}.seal{display:grid;place-items:center;min-width:72px;height:72px;border-radius:50%;background:#9af0c1;color:#073d2b;font-size:11px;font-weight:900;letter-spacing:.08em}.tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:16px}.tabs label{display:grid;place-items:center;min-height:44px;padding:8px;border:1px solid #3b6870;border-radius:14px;color:#c9e7eb;font-size:13px;font-weight:800;cursor:pointer;transition:.15s}.tabs label:hover{border-color:#73d9e7;color:#fff}.tab{position:absolute;opacity:0;pointer-events:none}.panels{min-height:190px}.panel{display:none;border:1px solid #31545b;border-radius:18px;padding:18px;background:#07171cd9}.panel h2{margin:0 0 14px;color:#73d9e7;font-size:14px;letter-spacing:.12em;text-transform:uppercase}.attributes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 22px;margin:0}.attribute{min-width:0;padding-bottom:9px;border-bottom:1px solid #25454b}.attribute dt{overflow:hidden;margin:0 0 5px;color:#78aab2;font-size:10px;font-weight:800;letter-spacing:.1em;text-overflow:ellipsis;text-transform:uppercase;white-space:nowrap}.attribute dd{overflow-wrap:anywhere;margin:0;color:#fff;font-size:15px;font-weight:700}#tab-identity:checked~.tabs label[for=tab-identity],#tab-sustainability:checked~.tabs label[for=tab-sustainability],#tab-lifecycle:checked~.tabs label[for=tab-lifecycle]{border-color:#8de8f2;background:#dffbff;color:#07323a}#tab-identity:checked~.panels .identity,#tab-sustainability:checked~.panels .sustainability,#tab-lifecycle:checked~.panels .lifecycle{display:block}.foot{display:flex;justify-content:space-between;gap:16px;margin-top:16px;color:#6f9ba2;font-family:monospace;font-size:10px}@media(max-width:520px){body{padding:10px}.passport{min-height:440px;padding:20px;border-radius:22px}.seal{display:none}.tabs{gap:5px}.tabs label{font-size:11px}.attributes{grid-template-columns:1fr}.panel{max-height:210px;overflow:auto}}</style></head><body><main class='passport'><p class='eyebrow'>Public digital product passport</p><div class='head'><div><h1>{{.metadata.name}}</h1><p>{{.metadata.description}}</p></div><div class='seal'>VERIFIED</div></div><input class='tab' type='radio' name='passport-tab' id='tab-identity' checked><input class='tab' type='radio' name='passport-tab' id='tab-sustainability'><input class='tab' type='radio' name='passport-tab' id='tab-lifecycle'><nav class='tabs' aria-label='Passport categories'><label for='tab-identity'>Identity</label><label for='tab-sustainability'>Sustainability</label><label for='tab-lifecycle'>Lifecycle</label></nav><div class='panels'><section class='panel identity'><h2>Identity</h2><dl class='attributes'>{{range .attributes}}{{if eq .category \"identity\"}}<div class='attribute'><dt>{{.key}}</dt><dd>{{.value}}</dd></div>{{end}}{{end}}</dl></section><section class='panel sustainability'><h2>Sustainability</h2><dl class='attributes'>{{range .attributes}}{{if eq .category \"sustainability\"}}<div class='attribute'><dt>{{.key}}</dt><dd>{{.value}}</dd></div>{{end}}{{end}}</dl></section><section class='panel lifecycle'><h2>Lifecycle</h2><dl class='attributes'>{{range .attributes}}{{if eq .category \"lifecycle\"}}<div class='attribute'><dt>{{.key}}</dt><dd>{{.value}}</dd></div>{{end}}{{end}}</dl></section></div><div class='foot'><span>OBJECT {{.id}}</span><span>OWNER {{.owner}}</span></div></main></body></html>"
    }
  ]
}
